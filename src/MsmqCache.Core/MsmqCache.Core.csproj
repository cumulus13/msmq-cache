<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <RootNamespace>MsmqCache.Core</RootNamespace>
    <Copyright>Copyright © 2026 Hadi Cahyadi</Copyright>
    <Authors>Hadi Cahyadi</Authors>
    <Company>cumulus13</Company>
    <RepositoryBranch>master</RepositoryBranch>
    <PackageId>MQCache-cli</PackageId>
    <Product>MSMQCache Core</Product>
    <Version>1.0.0</Version>
    <PackageTags>MSMQCache Core</PackageTags>
    <PackageProjectUrl>https://github.com/cumulus13/msmq-cache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cumulus13/msmq-cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- MSMQ helpers exist only for .NET Framework (System.Messaging is in-box there). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Messaging" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="Msmq\**" />
  </ItemGroup>
</Project>
